{
  "name": "cvm-tests-firestore-rules",
  "version": "1.0.0",
  "private": true,
  "description": "Black Box test aturan keamanan Firestore & Storage (PT Cipta Vera Mandiri)",
  "scripts": {
    "test": "jest --runInBand --ci"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "../results",
        "outputName": "firestore-rules-junit.xml",
        "classNameTemplate": "{classname}",
        "titleTemplate": "{title}",
        "suiteName": "Firestore & Storage Rules (Black Box)"
      }]
    ]
  }
}
