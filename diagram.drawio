                <mxCell id="admNotify" value="Notifikasi Real-time&#xa;- Listener attendance/request/dokumen/material sesuai role&#xa;- Overlay panel tandai baca &amp; navigasi modul terkait&#xa;- Dedup event &amp; sinkron status antar sesi admin" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0288D1;fillColor=#e1f5fe;fontSize=12;" parent="1-admin" vertex="1">
