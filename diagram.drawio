    <diagram id="admin-flow" name="Admin Dashboard Features">
        <mxGraphModel dx="3740" dy="1673" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="1">
            <root>
                <mxCell id="0-admin"/>
                <mxCell id="1-admin" parent="0-admin"/>
                <mxCell id="admStart" value="Admin membuka portal dashboard" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#1A237E;fillColor=#e8eaf6;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="490" y="20" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="admInit" value="Inisialisasi aplikasi admin&#xa;- Load .env &amp; Firebase.initializeApp&#xa;- Setup NotificationService, push channel, tema&#xa;- Prefetch repository &amp; glass theming" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#283593;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="450" y="120" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="admLogin" value="Halaman Login&#xa;- Form email + password (Firebase Auth)&#xa;- Validasi lokal &amp; snackbar error" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#303F9F;fillColor=#f3e5f5;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="450" y="250" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="admReset" value="Lupa kata sandi&#xa;- Kirim email reset via FirebaseAuth" style="parallelogram;whiteSpace=wrap;html=1;strokeColor=#6A1B9A;fillColor=#ede7f6;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="110" y="250" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="admCredCheck" value="Kredensial valid &amp; email terverifikasi?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#1E88E5;fillColor=#bbdefb;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="480" y="360" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="admError" value="Login gagal / email belum verifikasi&#xa;- Tampilkan snackbar &amp; hint verifikasi&#xa;- Tetap di form login" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D32F2F;fillColor=#ffebee;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="-10" y="400" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="admRoleFetch" value="Ambil profil &amp; role admin&#xa;- Fetch users/&lt;uid&gt;.roles + metadata&#xa;- Aktifkan listener notifikasi per modul&#xa;- Inject gating ke AdminDashboardShell" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0D47A1;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="450" y="500" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="admRoleCheck" value="Memiliki peran admin / superAdmin?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#00695C;fillColor=#b2dfdb;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="480" y="630" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="admDenied" value="Akses ditolak&#xa;- Sign out &amp; arahkan hubungi super admin" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B71C1C;fillColor=#ffebee;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="-40" y="620" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="admShell" value="Dashboard Shell&#xa;- NavigationRail &amp; layout responsif&#xa;- Welcome overlay, pencarian, quick actions bell&#xa;- Filter modul berdasar role aktif" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;fillColor=#e8f5e9;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="440" y="760" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="admOverview" value="Overview&#xa;- Ringkasan kehadiran harian &amp; akumulasi 12 bulan&#xa;- Kartu KPI hadir/izin/cuti &amp; highlight request terbaru&#xa;- Toggle diagram batang/pie &amp; cache profil karyawan" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E7D32;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="210" y="920" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="admAttendance" value="Absensi &amp; Window&#xa;- Stream log per hari dengan pencarian &amp; filter status/tim&#xa;- Detail modal: foto wajah, bukti lokasi, metadata perangkat&#xa;- Kelola jendela absensi (buka/tutup otomatis + auto close timer)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#00796B;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="550" y="1060" width="240" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="admRequests" value="Cuti &amp; Izin&#xa;- Kalender fokus (follow today) + tab daftar pending/riwayat&#xa;- Filter status/tanggal dengan cache profil pemohon&#xa;- Approve/reject mencatat admin pemutus &amp; notifikasi" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1976D2;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="840" y="920" width="240" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="admCalendar" value="Kalender Operasional&#xa;- Stream acara lintas bulan &amp; highlight event harian&#xa;- Dialog tambah event (kategori, lokasi, waktu, deskripsi)&#xa;- Aksi cepat: ke hari ini, geser bulan, sinkron ke dashboard" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5E35B1;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="1210" y="910" width="240" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="admDocuments" value="Pemberkasan&#xa;- Unggah file via FilePicker ke Storage&#xa;- Set tanggal kedaluwarsa &amp; interval pengingat otomatis&#xa;- Cari/filter dokumen, share tautan, buka/unduh, hapus" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6D4C41;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="70" y="1160" width="240" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="admMaterial" value="Permintaan Material&#xa;- Ringkasan pending/approved/delivered dengan counter&#xa;- Kartu detail item proyek &amp; timeline persetujuan&#xa;- Approve, tandai delivered, buka/unduh PDF auto-generated" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F57C00;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
                    <mxGeometry x="350" y="1280" width="240" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="admUsers" value="Manajemen Pengguna&#xa;- Cari &amp; pantau status kelengkapan profil&#xa;- Edit identitas, tim, departemen, role, PIN &amp; kontak&#xa;- Toggle hak akses modul &amp; terapkan real-time" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C2185B;fillColor=#ffffff;fontSize=12;" parent="1-admin" vertex="1">
