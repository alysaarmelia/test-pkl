<mxfile host="65bd71144e">
    <diagram id="employee-flow" name="Employee App Features">
        <mxGraphModel dx="2674" dy="1911" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" background="light-dark(#ffffff, #c1c1c1)" math="0" shadow="1">
            <root>
                <mxCell id="0-emp"/>
                <mxCell id="1-emp" parent="0-emp"/>
                <mxCell id="empStart" value="Pengguna membuka aplikasi karyawan" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0D47A1;fillColor=#e8f4ff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1150" y="10" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="empInit" value="Inisialisasi aplikasi mobile&#xa;- WidgetsFlutterBinding, load dotenv, Firebase.initializeApp&#xa;- Start layanan notifikasi, face recognition, push, chat, activity&#xa;- Prefetch kamera &amp; izin lokasi" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0D47A1;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1120" y="110" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="empAuthCheck" value="Sesi login &amp; email terverifikasi?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#1976D2;fillColor=#bbdefb;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1150" y="260" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="empAuthView" value="AuthView (Login/Sign Up)&#xa;- Form email &amp; password, toggle registrasi&#xa;- Kirim verifikasi email &amp; snackbar umpan balik&#xa;- Autologin setelah verifikasi sukses" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#283593;fillColor=#ede7f6;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="620" y="340" width="280" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="empForgot" value="Reset kata sandi&#xa;- Kirim email pemulihan via FirebaseAuth&#xa;- Instruksi lanjutan di snackbar" style="parallelogram;whiteSpace=wrap;html=1;strokeColor=#6A1B9A;fillColor=#f3e5f5;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="560" y="620" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="empProfileCheck" value="Profil karyawan lengkap?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#1B5E20;fillColor=#c8e6c9;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1150" y="400" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="empCompleteProfile" value="Lengkapi Profil&#xa;- Unggah foto (ImagePicker + Cropper) &amp; validasi rasio&#xa;- Isi nama, tim, role, PIN unik via ChatPinService&#xa;- Simpan ke Firestore &amp; Storage dengan retry" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1710" y="300" width="300" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="empHome" value="HomePage + FloatingNav&#xa;- Bottom nav 5 tab (Home, Chat, Kalender, Profil, Pengaturan)&#xa;- Menu grid bisa trigger perpindahan tab&#xa;- IndexedStack simpan state per modul" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0D47A1;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1120" y="550" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="empDashboard" value="Dashboard Utama&#xa;- Kartu profil &amp; progres kelengkapan&#xa;- MenuGrid akses cepat ke Absensi, Material, Pemberkasan&#xa;- NewsSection &amp; UpcomingEvents sinkron kalender admin" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0D47A1;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="830" y="830" width="280" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="empAttendance" value="Absensi &amp; Perizinan&#xa;- Check-in/out wajah + tantangan liveness &amp; geo-fence&#xa;- Unggah bukti foto/lokasi, catat catatan otomatis perangkat&#xa;- Ajukan cuti/izin, pantau status &amp; riwayat 30 hari" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1B5E20;fillColor=#e8f5e9;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1130" y="730" width="280" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="empCalendar" value="Kalender Tim&#xa;- TableCalendar + API hari libur nasional&#xa;- Tambah acara (judul, kategori, jam, lokasi, deskripsi)&#xa;- Sorot event mendatang &amp; sync ke dashboard home" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#00695C;fillColor=#e0f2f1;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1500" y="725" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="empMaterial" value="Permintaan Material&#xa;- Form multi-item generate DOCX/PDF otomatis&#xa;- Simpan request ke Firestore + Storage dengan status pending&#xa;- Tracking status &amp; mark delivered, akses/unduh PDF" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F57C00;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="690" y="1110" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="empDocs" value="Pemberkasan Karyawan&#xa;- Stream dokumen pribadi dengan pencarian &amp; filter kedaluwarsa&#xa;- Unggah file (mobile/web) + set pengingat sebelum jatuh tempo&#xa;- Buka tautan, unduh, hapus &amp; trigger notifikasi admin" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6D4C41;fillColor=#ffffff;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1060" y="1110" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="empChat" value="Chat &amp; Kolaborasi&#xa;- Daftar chat dengan pin, arsip, sembunyikan &amp; pencarian&#xa;- Group chat, kontak internal, avatar caching Firebase Storage&#xa;- Tandai unread &amp; notifikasi real-time (Push + Firestore)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#283593;fillColor=#ede7f6;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1660" y="1060" width="280" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="empSettings" value="Profil &amp; Pengaturan&#xa;- Lihat/ubah profil, update foto &amp; PIN dalam QR modal&#xa;- Kelola perizinan notifikasi &amp; kontak internal (ContactList)&#xa;- Akses shortcut profil/chat &amp; logout multi platform" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6A1B9A;fillColor=#f3e5f5;fontSize=12;" parent="1-emp" vertex="1">
                    <mxGeometry x="1410" y="1290" width="280" height="160" as="geometry"/>
