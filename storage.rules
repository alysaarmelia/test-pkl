rules_version = '2';

// WARNING: This is a default ruleset that allows all reads and writes.
// You should secure your storage before going to production.
// See https://firebase.google.com/docs/storage/security for more information.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
